#!/usr/bin/env zsh
# shellcheck shell=bash
#
# imac-linux-check — report an iMac's hardware and what will/won't work under Linux.
#
# HARD RULES (see ROADMAP.md / the project spec):
#   * READ-ONLY on the host. No writes outside ~/.cache/imac-linux-check/.
#   * Data only, never code. This script parses inert JSON; it never fetches or
#     executes remote content.
#
# Milestone 2: I/O skeleton + fixture harness. Detects model, macOS version, T2
# presence, and looks the model up in the bundled dataset. PCI-ID extraction and
# network data tiers arrive in later milestones.
#
# JSON parsing uses `plutil` (always present on macOS) or `jq` (Linux/CI), so the
# tool needs no third-party dependency on a real Mac.

set -u

VERSION="0.6.0-dev"

# --- locate ourselves and the bundled dataset ------------------------------

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
BUNDLED_DATA="$SCRIPT_DIR/../data"

# --- options ---------------------------------------------------------------

FIXTURE_DIR=""
OUTPUT="human"      # human | json | markdown
VERBOSE=0
OFFLINE=0           # accepted now; network tiers land in a later milestone
USE_COLOR="auto"    # auto | always | never

err() { printf '%s\n' "imac-linux-check: $*" >&2; }

usage() {
  cat <<'EOF'
imac-linux-check — will Linux work on this iMac?

Usage: imac-linux-check [options]

Options:
  --json               Machine-readable output.
  --markdown           Markdown output, for pasting into issues/forum posts.
  --verbose            Include provenance dates and raw detection detail.
  --offline            Skip the network; use cached or bundled data only.
  --fixture-dir DIR    Read captured tool output from DIR instead of live hardware.
  --no-color           Disable ANSI colour.
  -h, --help           Show this help.
  --version            Print version.

This tool is read-only and fetches inert JSON only. It never modifies the machine.
EOF
}

# --- PCI vendor/device-id extraction (the highest-risk code, see spec §6.2) --
#
# macOS stores these as little-endian byte arrays in the IORegistry, e.g.
#   "vendor-id" = <02100000>   ->  0x1002
#   "device-id" = <19680000>   ->  0x6819
# A PCI id is a 16-bit value; the low two bytes hold it little-endian and the
# rest is padding. Swap the first two bytes to get the canonical id, so results
# line up with `lspci -nn` and existing Linux hardware databases.

# pci_swap_id HEXBLOB  ->  4-hex-digit id, or non-zero exit on bad input
# Accepts "<02100000>", "02100000", "0210", upper or lower case.
pci_swap_id() {
  local h="${1#<}"
  h="${h%>}"
  h="$(printf '%s' "$h" | tr 'A-F' 'a-f' | tr -cd '0-9a-f')"
  case "$h" in
    '' ) return 1 ;;
  esac
  [ "${#h}" -ge 4 ] || return 1
  printf '%s%s' "${h:2:2}" "${h:0:2}"
}

# extract_pci_ids  — read `ioreg -l` text on stdin, print one "vendor:device"
# per IOPCIDevice node. Pairs the two ids within a node regardless of the order
# they are printed; ignores subsystem-vendor-id / subsystem-id.
extract_pci_ids() {
  local line hex v="" d=""
  while IFS= read -r line; do
    case "$line" in
      *"<class IOPCIDevice"*)
        if [ -n "$v" ] && [ -n "$d" ]; then printf '%s:%s\n' "$v" "$d"; fi
        v=""; d="" ;;
      *'"vendor-id" = <'*)
        hex="$(printf '%s' "$line" | sed -n 's/.*"vendor-id" = <\([0-9a-fA-F]*\).*/\1/p')"
        v="$(pci_swap_id "$hex" || printf '')" ;;
      *'"device-id" = <'*)
        hex="$(printf '%s' "$line" | sed -n 's/.*"device-id" = <\([0-9a-fA-F]*\).*/\1/p')"
        d="$(pci_swap_id "$hex" || printf '')" ;;
    esac
  done
  if [ -n "$v" ] && [ -n "$d" ]; then printf '%s:%s\n' "$v" "$d"; fi
}

# Hidden entrypoints so the two functions above can be unit-tested in isolation.
case "${1:-}" in
  __pci-swap)    shift; pci_swap_id "${1:-}"; exit $? ;;
  __pci-extract) extract_pci_ids; exit 0 ;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)        usage; exit 0 ;;
    --version)        printf '%s\n' "$VERSION"; exit 0 ;;
    --json)           OUTPUT="json"; shift ;;
    --markdown)       OUTPUT="markdown"; shift ;;
    --verbose)        VERBOSE=1; shift ;;
    --offline)        OFFLINE=1; shift ;;
    --no-color)       USE_COLOR="never"; shift ;;
    --fixture-dir)    FIXTURE_DIR="${2:-}"; shift 2 ;;
    --fixture-dir=*)  FIXTURE_DIR="${1#*=}"; shift ;;
    --)               shift; break ;;
    -*)               err "unknown option: $1"; usage >&2; exit 2 ;;
    *)                err "unexpected argument: $1"; exit 2 ;;
  esac
done

if [ -n "$FIXTURE_DIR" ] && [ ! -d "$FIXTURE_DIR" ]; then
  err "fixture dir not found: $FIXTURE_DIR"
  exit 2
fi

# --- JSON engine -----------------------------------------------------------

if command -v plutil >/dev/null 2>&1; then
  JSON_ENGINE="plutil"
elif command -v jq >/dev/null 2>&1; then
  JSON_ENGINE="jq"
else
  JSON_ENGINE="none"
fi

# Paths below are engine-neutral, dot-separated, with bare numeric array
# indices, e.g. "linux.status" or "variants.0.distinguish_by.pci". plutil takes
# them as-is; _to_jq rewrites numeric segments to jq's [n] bracket form.
_to_jq() {
  printf '%s' "$1" | awk -F. '{
    out="";
    for (i = 1; i <= NF; i++) {
      if ($i ~ /^[0-9]+$/) out = out "[" $i "]";
      else out = out "." $i;
    }
    print out;
  }'
}

# json_scalar FILE PATH  — one scalar value, or empty
json_scalar() {
  case "$JSON_ENGINE" in
    jq)     jq -r "$(_to_jq "$2") // empty" "$1" 2>/dev/null ;;
    plutil) plutil -extract "$2" raw -o - "$1" 2>/dev/null ;;
    *)      return 1 ;;
  esac
}

# json_list FILE PATH  — array of scalars, one per line
json_list() {
  case "$JSON_ENGINE" in
    jq)     jq -r "$(_to_jq "$2")[]? // empty" "$1" 2>/dev/null ;;
    plutil) plutil -extract "$2" json -o - "$1" 2>/dev/null \
              | tr -d '[]"' | tr ',' '\n' | sed 's/^ *//; s/ *$//; /^$/d' ;;
    *)      return 1 ;;
  esac
}

# json_count FILE PATH  — number of elements in an array (0 if absent)
json_count() {
  local n
  case "$JSON_ENGINE" in
    jq) jq -r "($(_to_jq "$2") // []) | length" "$1" 2>/dev/null ;;
    plutil)
      n="$(plutil -extract "$2" json -o - "$1" 2>/dev/null | grep -o '{' | wc -l | tr -d ' ')"
      [ -n "$n" ] && printf '%s' "$n" || printf '0' ;;
    *) printf '0' ;;
  esac
}

# json_pairs FILE PATH  — object as "key<TAB>value" lines (keys/values here are
# component ids: [a-z0-9-], so the plutil string-split path is safe).
json_pairs() {
  case "$JSON_ENGINE" in
    jq) jq -r "$(_to_jq "$2") | to_entries[]? | \"\(.key)\t\(.value)\"" "$1" 2>/dev/null ;;
    plutil)
      plutil -extract "$2" json -o - "$1" 2>/dev/null \
        | sed 's/[{}"]//g; s/, /\n/g; s/,/\n/g' \
        | sed 's/^ *//; s/ *$//; /^$/d; s/:/\t/' ;;
    *) return 1 ;;
  esac
}

# --- capture boundary: live hardware OR fixture files ----------------------

capture() {
  if [ -n "$FIXTURE_DIR" ]; then
    local f=""
    case "$1" in
      system_profiler) f="$FIXTURE_DIR/system_profiler.json" ;;
      hw_model)        f="$FIXTURE_DIR/hw_model.txt" ;;
      sw_vers)         f="$FIXTURE_DIR/sw_vers.txt" ;;
      ioreg)           f="$FIXTURE_DIR/ioreg.txt" ;;
      *)               return 1 ;;
    esac
    [ -f "$f" ] || return 1
    cat -- "$f"
    return 0
  fi

  case "$1" in
    system_profiler)
      system_profiler -json \
        SPHardwareDataType SPDisplaysDataType SPAirPortDataType \
        SPAudioDataType SPStorageDataType SPNVMeDataType \
        SPSerialATADataType SPBluetoothDataType SPThunderboltDataType \
        SPCameraDataType SPiBridgeDataType SPMemoryDataType ;;
    hw_model) sysctl -n hw.model ;;
    sw_vers)  sw_vers ;;
    ioreg)    ioreg -l -p IOService ;;
    *)        return 1 ;;
  esac
}

# --- data resolution tiers -------------------------------------------------
#
# For each data file, resolution order is:
#   1. local cache (~/.cache/imac-linux-check/data/), if fresher than 24h
#   2. network fetch from the CDN, pinned to a RELEASE TAG (never main)
#   3. bundled snapshot that ships with the script
#
# Only inert JSON is fetched, and it is structurally validated before use;
# anything that fails validation is skipped in favour of the next tier. The
# tool never fails hard when the network is unavailable.

CDN_OWNER_REPO="petershevchenko/imac-linux-check"
CDN_TAG="v1"   # pinned release tag — a bad merge to main must never reach users
# Base may be overridden for testing (e.g. a file:// tree); production is https.
CDN_BASE="${IMAC_LC_CDN_BASE:-https://cdn.jsdelivr.net/gh/${CDN_OWNER_REPO}@${CDN_TAG}}"
NET_TIMEOUT="${IMAC_LC_NET_TIMEOUT:-8}"
CACHE_TTL_SECONDS=$((24 * 60 * 60))
# The date this script's bundled data snapshot was cut (stamped at release).
SNAPSHOT_DATE="2026-08-05"

CACHE_DIR="${IMAC_LC_CACHE_DIR:-${HOME:-/tmp}/.cache/imac-linux-check}"
mkdir -p "$CACHE_DIR" 2>/dev/null || CACHE_DIR="."
CACHE_DATA_DIR="$CACHE_DIR/data"

file_mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null; }

is_fresh() {
  local mt now
  mt="$(file_mtime "$1")"; [ -n "$mt" ] || return 1
  now="$(date +%s)"
  [ "$((now - mt))" -lt "$CACHE_TTL_SECONDS" ]
}

# validate_data FILE RELPATH — lightweight structural check (full JSON Schema
# validation lives in CI). Confirms the file parses and has the fields we rely
# on, which is what closes the "malformed or tampered file" gap on load.
validate_data() {
  local file="$1" rel="$2"
  case "$JSON_ENGINE" in
    jq)     jq -e . "$file" >/dev/null 2>&1 || return 1 ;;
    plutil) plutil -lint "$file" >/dev/null 2>&1 || return 1 ;;
    *)      return 1 ;;
  esac
  case "$rel" in
    models/*)
      [ -n "$(json_scalar "$file" model_identifier)" ] || return 1
      [ -n "$(json_list "$file" components | head -1)" ] || return 1 ;;
    components/*)
      [ -n "$(json_scalar "$file" id)" ] || return 1
      [ -n "$(json_scalar "$file" 'linux.status')" ] || return 1 ;;
  esac
  return 0
}

# resolve_data RELPATH — print "TIER\tPATH" for the file to read, or nothing.
# Populates the cache from the network when it can. RELPATH is relative to
# data/, e.g. "models/imac17-1.json".
resolve_data() {
  local rel="$1"
  local cache_file="$CACHE_DATA_DIR/$rel"
  local bundled_file="$BUNDLED_DATA/$rel"
  local tmp

  # tier 1: fresh, valid cache
  if [ -f "$cache_file" ] && is_fresh "$cache_file" && validate_data "$cache_file" "$rel"; then
    printf '%s\t%s' "cache" "$cache_file"; return 0
  fi

  # tier 2: network (skipped when --offline or curl is absent)
  if [ "$OFFLINE" -ne 1 ] && command -v curl >/dev/null 2>&1; then
    tmp="$(mktemp "$CACHE_DIR/fetch.XXXXXX" 2>/dev/null || printf '%s' "$CACHE_DIR/fetch.$$")"
    if curl -fsSL --max-time "$NET_TIMEOUT" --max-redirs 3 "$CDN_BASE/data/$rel" -o "$tmp" 2>/dev/null \
        && validate_data "$tmp" "$rel"; then
      mkdir -p "$(dirname "$cache_file")" 2>/dev/null
      if mv "$tmp" "$cache_file" 2>/dev/null; then
        printf '%s\t%s' "network" "$cache_file"; return 0
      fi
      printf '%s\t%s' "network" "$tmp"; return 0
    fi
    rm -f "$tmp" 2>/dev/null
  fi

  # tier 2b: stale-but-valid cache beats nothing
  if [ -f "$cache_file" ] && validate_data "$cache_file" "$rel"; then
    printf '%s\t%s' "cache-stale" "$cache_file"; return 0
  fi

  # tier 3: bundled snapshot (shipped with the script; trusted like the code)
  if [ -f "$bundled_file" ]; then
    printf '%s\t%s' "bundled" "$bundled_file"; return 0
  fi
  return 1
}

# local_data_path RELPATH — resolved local file WITHOUT touching the network
# (used after prefetch, so rendering never re-fetches).
local_data_path() {
  if [ -f "$CACHE_DATA_DIR/$1" ]; then printf '%s' "$CACHE_DATA_DIR/$1"; return 0; fi
  if [ -f "$BUNDLED_DATA/$1" ]; then printf '%s' "$BUNDLED_DATA/$1"; return 0; fi
  return 1
}

# snapshot_age_note — "dated 2026-08-05 (~2 months old)", falling back to the
# bare date where the platform's `date` cannot parse it.
snapshot_age_note() {
  local se now months
  se="$(date -d "$SNAPSHOT_DATE" +%s 2>/dev/null || date -j -f %Y-%m-%d "$SNAPSHOT_DATE" +%s 2>/dev/null)"
  if [ -n "$se" ]; then
    now="$(date +%s)"
    months=$(( (now - se) / (30 * 24 * 60 * 60) ))
    printf 'dated %s, ~%s months old' "$SNAPSHOT_DATE" "$months"
  else
    printf 'dated %s' "$SNAPSHOT_DATE"
  fi
}

# --- gather raw inputs once ------------------------------------------------

SP_FILE="$(mktemp "$CACHE_DIR/run.XXXXXX" 2>/dev/null || printf '%s' "$CACHE_DIR/run.$$")"
trap 'rm -f "$SP_FILE" 2>/dev/null' EXIT

capture system_profiler > "$SP_FILE" 2>/dev/null || : > "$SP_FILE"

HW_MODEL="$(capture hw_model 2>/dev/null | head -1 | tr -d '[:space:]')"
SW_VERS="$(capture sw_vers 2>/dev/null || true)"
IOREG_RAW="$(capture ioreg 2>/dev/null || true)"
IOREG_LINES="$(printf '%s\n' "$IOREG_RAW" | grep -Ec '"(vendor|device)-id"' || true)"
[ -n "$IOREG_LINES" ] || IOREG_LINES=0
DETECTED_PCI="$(printf '%s\n' "$IOREG_RAW" | extract_pci_ids)"

# --- detection -------------------------------------------------------------

sw_field() {
  printf '%s\n' "$SW_VERS" | awk -v k="$1" 'index($0,k)==1{sub(/^[^:]*:[ \t]*/,""); print; exit}'
}
MACOS_NAME="$(sw_field ProductName)"
MACOS_VER="$(sw_field ProductVersion)"

detect_t2() {
  case "$JSON_ENGINE" in
    jq)
      if jq -e '((.SPiBridgeDataType // []) | length) > 0' "$SP_FILE" >/dev/null 2>&1; then
        printf 'yes'
      else printf 'no'; fi ;;
    plutil)
      if plutil -extract SPiBridgeDataType json -o - "$SP_FILE" 2>/dev/null | grep -q '[{"]'; then
        printf 'yes'
      else printf 'no'; fi ;;
    *) printf 'unknown' ;;
  esac
}
T2="$(detect_t2)"

model_slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr ',' '-'; }
MODEL_FILE=""
MODEL_KNOWN="no"
MARKETING_NAME=""
DATA_TIER=""
if [ -n "$HW_MODEL" ]; then
  resolved="$(resolve_data "models/$(model_slug "$HW_MODEL").json" 2>/dev/null || true)"
  if [ -n "$resolved" ]; then
    DATA_TIER="${resolved%%$'\t'*}"
    MODEL_FILE="${resolved#*$'\t'}"
    MODEL_KNOWN="yes"
    MARKETING_NAME="$(json_scalar "$MODEL_FILE" 'marketing_name')"
  fi
fi

# Human-readable label for the tier the model record came from.
case "$DATA_TIER" in
  network)     DATA_SOURCE="network (jsDelivr @$CDN_TAG)" ;;
  cache)       DATA_SOURCE="cache" ;;
  cache-stale) DATA_SOURCE="cache (stale)" ;;
  *)           DATA_SOURCE="bundled" ;;
esac

# --- variant resolution by detected PCI id ---------------------------------
# If a model variant's distinguish_by.pci matches a detected id, that variant
# applies and its components_replace map swaps base component ids.

pci_detected() { printf '%s\n' "$DETECTED_PCI" | grep -Fxq "$1"; }

matched_variant() {
  # prints the index of the first matching variant, or nothing
  [ -n "$MODEL_FILE" ] || return 1
  local n i pci
  n="$(json_count "$MODEL_FILE" variants)"
  case "$n" in ''|*[!0-9]*) return 1 ;; esac
  i=0
  while [ "$i" -lt "$n" ]; do
    while IFS= read -r pci; do
      [ -n "$pci" ] || continue
      if pci_detected "$pci"; then printf '%s' "$i"; return 0; fi
    done <<EOF
$(json_list "$MODEL_FILE" "variants.$i.distinguish_by.pci")
EOF
    i=$((i + 1))
  done
  return 1
}

VARIANT_INDEX="$(matched_variant || true)"
VARIANT_DESC=""
VARIANT_REPLACEMENTS=""
if [ -n "$VARIANT_INDEX" ]; then
  VARIANT_DESC="$(json_scalar "$MODEL_FILE" "variants.$VARIANT_INDEX.description")"
  VARIANT_REPLACEMENTS="$(json_pairs "$MODEL_FILE" "variants.$VARIANT_INDEX.components_replace")"
fi

# resolved_components -> component ids after applying the matched variant
resolved_components() {
  [ -n "$MODEL_FILE" ] || return 0
  local id newid
  json_list "$MODEL_FILE" 'components' | while IFS= read -r id; do
    [ -n "$id" ] || continue
    newid="$id"
    if [ -n "$VARIANT_REPLACEMENTS" ]; then
      newid="$(printf '%s\n' "$VARIANT_REPLACEMENTS" | awk -F'\t' -v k="$id" '$1==k{print $2; exit}')"
      [ -n "$newid" ] || newid="$id"
    fi
    printf '%s\n' "$newid"
  done
}

# Prefetch each component through the tier resolver once (populating the cache),
# so the renderers — which may call collect_subsystems several times — read from
# local files and never re-hit the network.
if [ "$MODEL_KNOWN" = "yes" ]; then
  resolved_components | while IFS= read -r id; do
    [ -n "$id" ] || continue
    resolve_data "components/$id.json" >/dev/null 2>&1 || true
  done
fi

# collect_subsystems -> TSV rows: category  status  name  id  last_verified  file
collect_subsystems() {
  [ -n "$MODEL_FILE" ] || return 0
  resolved_components | while IFS= read -r id; do
    [ -n "$id" ] || continue
    cf="$(local_data_path "components/$id.json")"
    if [ -n "$cf" ] && [ -f "$cf" ]; then
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$(json_scalar "$cf" 'category')" \
        "$(json_scalar "$cf" 'linux.status')" \
        "$(json_scalar "$cf" 'name')" \
        "$id" \
        "$(json_scalar "$cf" 'linux.provenance.last_verified')" \
        "$cf"
    else
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "?" "unknown" "(missing component file)" "$id" "" ""
    fi
  done
}

# severity_color SEV -> ANSI colour for a caveat severity
severity_color() {
  case "$1" in
    major)    printf '%s' "$C_RED" ;;
    moderate) printf '%s' "$C_YELLOW" ;;
    *)        printf '%s' "$C_DIM" ;;
  esac
}

# render_caveats FILE INDENT — one line per caveat; detail added under --verbose
render_caveats() {
  local f="$1" ind="$2" n i sev sum det
  [ -n "$f" ] || return 0
  n="$(json_count "$f" 'linux.caveats')"; case "$n" in ''|*[!0-9]*) n=0 ;; esac
  i=0
  while [ "$i" -lt "$n" ]; do
    sev="$(json_scalar "$f" "linux.caveats.$i.severity")"
    sum="$(json_scalar "$f" "linux.caveats.$i.summary")"
    printf '%s%s!%s %s %s(%s)%s\n' "$ind" "$(severity_color "$sev")" "$C_RESET" "$sum" "$C_DIM" "$sev" "$C_RESET"
    if [ "$VERBOSE" -eq 1 ]; then
      det="$(json_scalar "$f" "linux.caveats.$i.detail")"
      [ -n "$det" ] && printf '%s  %s%s%s\n' "$ind" "$C_DIM" "$det" "$C_RESET"
    fi
    i=$((i + 1))
  done
}

# render_workarounds FILE INDENT — the fix line per workaround; problem and
# kernel params added under --verbose
render_workarounds() {
  local f="$1" ind="$2" n i fix problem add rem
  [ -n "$f" ] || return 0
  n="$(json_count "$f" 'linux.workarounds')"; case "$n" in ''|*[!0-9]*) n=0 ;; esac
  i=0
  while [ "$i" -lt "$n" ]; do
    fix="$(json_scalar "$f" "linux.workarounds.$i.fix")"
    printf '%s%s\xe2\x86\x92 fix:%s %s\n' "$ind" "$C_CYAN" "$C_RESET" "$fix"
    if [ "$VERBOSE" -eq 1 ]; then
      problem="$(json_scalar "$f" "linux.workarounds.$i.problem")"
      [ -n "$problem" ] && printf '%s   %swhen: %s%s\n' "$ind" "$C_DIM" "$problem" "$C_RESET"
      add="$(json_list "$f" "linux.workarounds.$i.kernel_params_add" | tr '\n' ' ' | sed 's/ *$//')"
      rem="$(json_list "$f" "linux.workarounds.$i.kernel_params_remove" | tr '\n' ' ' | sed 's/ *$//')"
      [ -n "$add" ] && printf '%s   %sadd kernel params: %s%s\n' "$ind" "$C_DIM" "$add" "$C_RESET"
      [ -n "$rem" ] && printf '%s   %sremove kernel params: %s%s\n' "$ind" "$C_DIM" "$rem" "$C_RESET"
    fi
    i=$((i + 1))
  done
}

# --- colour ----------------------------------------------------------------

C_RESET=""; C_BOLD=""; C_DIM=""; C_GREEN=""; C_YELLOW=""; C_RED=""; C_CYAN=""
color_on=0
case "$USE_COLOR" in
  always) color_on=1 ;;
  never)  color_on=0 ;;
  auto)   [ -t 1 ] && color_on=1 ;;
esac
if [ "$color_on" -eq 1 ]; then
  C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
  C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'; C_CYAN=$'\033[36m'
fi

status_color() {
  case "$1" in
    works)                                              printf '%s' "$C_GREEN" ;;
    works_with_caveats|works_with_workaround|partial)   printf '%s' "$C_YELLOW" ;;
    needs_out_of_tree_driver)                           printf '%s' "$C_YELLOW" ;;
    broken)                                             printf '%s' "$C_RED" ;;
    *)                                                  printf '%s' "$C_DIM" ;;
  esac
}

# --- renderers -------------------------------------------------------------

render_human() {
  printf '%s%simac-linux-check%s — will Linux work on this iMac?\n\n' "$C_BOLD" "$C_CYAN" "$C_RESET"

  printf '  %-9s %s' "Model:" "${HW_MODEL:-unknown}"
  [ -n "$MARKETING_NAME" ] && printf '  %s(%s)%s' "$C_DIM" "$MARKETING_NAME" "$C_RESET"
  printf '\n'
  printf '  %-9s %s %s\n' "macOS:" "${MACOS_NAME:-unknown}" "${MACOS_VER:-}"
  printf '  %-9s %s\n' "T2 chip:" "$T2"
  [ -n "$VARIANT_DESC" ] && printf '  %-9s %s\n' "Variant:" "$VARIANT_DESC"
  case "$DATA_TIER" in
    network|cache|cache-stale) printf '  %-9s %s\n' "Data:" "$DATA_SOURCE" ;;
    *)                         printf '  %-9s bundled %s(%s)%s\n' "Data:" "$C_DIM" "$(snapshot_age_note)" "$C_RESET" ;;
  esac

  if [ "$T2" = "yes" ]; then
    printf '\n%s%s  T2 security chip detected.%s This changes everything for keyboard,\n' "$C_BOLD" "$C_YELLOW" "$C_RESET"
    printf '  trackpad, audio and SSD. Follow the t2linux project: https://t2linux.org\n'
  fi

  if [ "$MODEL_KNOWN" != "yes" ]; then
    printf '\n%sThis model is not in the database yet.%s\n' "$C_YELLOW" "$C_RESET"
    printf '  No verified data exists for %s, and support is never guessed from a\n' "${HW_MODEL:-this machine}"
    printf '  neighbouring model.\n'
    url="$(report_url || true)"
    if [ -n "$url" ]; then
      printf '\n  %sHelp add it — this pre-filled report has everything needed:%s\n' "$C_BOLD" "$C_RESET"
      printf '  %s\n' "$url"
    else
      printf '\n  Your hardware dump is large. Open a blank report at:\n'
      printf '  %s\n' "https://github.com/$CDN_OWNER_REPO/issues/new?template=new-model.yml"
      printf '  and paste this JSON into it:\n\n'
      render_json
    fi
    return 0
  fi

  printf '\n  %sSubsystems%s\n' "$C_BOLD" "$C_RESET"
  collect_subsystems | while IFS="$(printf '\t')" read -r cat st name id lv cf; do
    sc="$(status_color "$st")"
    printf '    %-9s %s[%s]%s %s' "$cat" "$sc" "$st" "$C_RESET" "$name"
    if [ "$VERBOSE" -eq 1 ]; then
      printf '\n              %sid=%s' "$C_DIM" "$id"
      [ -n "$lv" ] && printf '  last_verified=%s' "$lv"
      printf '%s' "$C_RESET"
    fi
    printf '\n'
    render_caveats "$cf" "              "
    render_workarounds "$cf" "              "
  done

  printf '\n  %sPer-subsystem status, no overall score — apply your own weighting.%s\n' "$C_DIM" "$C_RESET"
  if [ "$VERBOSE" -eq 1 ]; then
    printf '  %sdetected PCI ids: %s%s\n' "$C_DIM" "$(printf '%s' "$DETECTED_PCI" | tr '\n' ' ')" "$C_RESET"
    printf '  %sioreg vendor/device-id lines seen: %s  |  json engine: %s  |  offline: %s%s\n' \
      "$C_DIM" "$IOREG_LINES" "$JSON_ENGINE" "$( [ "$OFFLINE" -eq 1 ] && printf yes || printf no )" "$C_RESET"
  fi
}

render_markdown() {
  printf '## imac-linux-check report\n\n'
  printf '| Field | Value |\n| --- | --- |\n'
  # shellcheck disable=SC2016  # literal backticks are intended markdown, not command substitution
  printf '| Model | `%s`%s |\n' "${HW_MODEL:-unknown}" "$( [ -n "$MARKETING_NAME" ] && printf ' — %s' "$MARKETING_NAME" )"
  printf '| macOS | %s %s |\n' "${MACOS_NAME:-unknown}" "${MACOS_VER:-}"
  printf '| T2 chip | %s |\n' "$T2"
  [ -n "$VARIANT_DESC" ] && printf '| Variant | %s |\n' "$VARIANT_DESC"
  printf '| Data source | %s (snapshot %s) |\n' "$DATA_SOURCE" "$SNAPSHOT_DATE"

  if [ "$MODEL_KNOWN" != "yes" ]; then
    # shellcheck disable=SC2016  # literal backticks are intended markdown
    printf '\n> This model is not in the database yet. No verified data for `%s`.\n' "${HW_MODEL:-this machine}"
    url="$(report_url || true)"
    if [ -n "$url" ]; then
      printf '\n[Add this model](%s)\n' "$url"
    fi
    return 0
  fi

  printf '\n### Subsystems\n\n| Subsystem | Status | Component |\n| --- | --- | --- |\n'
  collect_subsystems | while IFS="$(printf '\t')" read -r cat st name id lv cf; do
    # shellcheck disable=SC2016  # literal backticks are intended markdown
    printf '| %s | `%s` | %s |\n' "$cat" "$st" "$name"
  done

  # Caveats & fixes, only for subsystems that have any.
  details="$(collect_subsystems | while IFS="$(printf '\t')" read -r cat st name id lv cf; do
    [ -n "$cf" ] || continue
    ncav="$(json_count "$cf" 'linux.caveats')"; case "$ncav" in ''|*[!0-9]*) ncav=0 ;; esac
    nwork="$(json_count "$cf" 'linux.workarounds')"; case "$nwork" in ''|*[!0-9]*) nwork=0 ;; esac
    [ "$ncav" -eq 0 ] && [ "$nwork" -eq 0 ] && continue
    printf '\n**%s — %s**\n\n' "$cat" "$name"
    i=0
    while [ "$i" -lt "$ncav" ]; do
      printf -- '- caveat (%s): %s\n' \
        "$(json_scalar "$cf" "linux.caveats.$i.severity")" \
        "$(json_scalar "$cf" "linux.caveats.$i.summary")"
      i=$((i + 1))
    done
    i=0
    while [ "$i" -lt "$nwork" ]; do
      printf -- '- fix: %s\n' "$(json_scalar "$cf" "linux.workarounds.$i.fix")"
      i=$((i + 1))
    done
  done)"
  if [ -n "$details" ]; then
    printf '\n### Caveats & fixes\n%s\n' "$details"
  fi
}

# minimal JSON string escaping for values we emit
json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

render_json() {
  printf '{\n'
  printf '  "tool_version": "%s",\n' "$(json_escape "$VERSION")"
  printf '  "model_identifier": "%s",\n' "$(json_escape "${HW_MODEL}")"
  printf '  "model_known": %s,\n' "$( [ "$MODEL_KNOWN" = "yes" ] && printf 'true' || printf 'false' )"
  printf '  "marketing_name": "%s",\n' "$(json_escape "$MARKETING_NAME")"
  printf '  "macos": { "name": "%s", "version": "%s" },\n' "$(json_escape "$MACOS_NAME")" "$(json_escape "$MACOS_VER")"
  printf '  "t2_chip": %s,\n' "$( [ "$T2" = "yes" ] && printf 'true' || printf 'false' )"
  printf '  "data_source": "%s",\n' "$(json_escape "${DATA_TIER:-bundled}")"
  printf '  "snapshot_date": "%s",\n' "$SNAPSHOT_DATE"
  printf '  "offline": %s,\n' "$( [ "$OFFLINE" -eq 1 ] && printf 'true' || printf 'false' )"
  if [ -n "$VARIANT_DESC" ]; then
    printf '  "variant": "%s",\n' "$(json_escape "$VARIANT_DESC")"
  else
    printf '  "variant": null,\n'
  fi
  printf '  "detected_pci": ['
  firstp=1
  printf '%s\n' "$DETECTED_PCI" | while IFS= read -r p; do
    [ -n "$p" ] || continue
    [ "$firstp" -eq 1 ] && printf ' "%s"' "$(json_escape "$p")" || printf ', "%s"' "$(json_escape "$p")"
    firstp=0
  done
  printf ' ],\n'
  printf '  "subsystems": ['
  first=1
  collect_subsystems | while IFS="$(printf '\t')" read -r cat st name id lv cf; do
    [ "$first" -eq 1 ] && printf '\n' || printf ',\n'
    first=0
    printf '    { "id": "%s", "category": "%s", "status": "%s", "name": "%s", "last_verified": "%s" }' \
      "$(json_escape "$id")" "$(json_escape "$cat")" "$(json_escape "$st")" \
      "$(json_escape "$name")" "$(json_escape "$lv")"
  done
  # close the array (handle empty case cleanly)
  if [ -n "$MODEL_FILE" ] && [ -n "$(collect_subsystems)" ]; then
    printf '\n  ]\n'
  else
    printf ' ]\n'
  fi
  printf '}\n'
}

# --- contribution funnel: pre-filled issue for unknown models --------------

# GitHub caps issue URLs near 8k; beyond this, fall back to print-and-paste.
ISSUE_MAX_URL="${IMAC_LC_ISSUE_MAX_URL:-8000}"

# urlencode STRING — percent-encode for a query parameter (RFC 3986 unreserved
# set kept literal). Byte-wise under LC_ALL=C so multibyte input can't slip
# through unencoded.
urlencode() {
  local s="$1" i=0 c out=""
  local LC_ALL=C
  while [ "$i" -lt "${#s}" ]; do
    c="${s:$i:1}"
    case "$c" in
      [a-zA-Z0-9.~_-]) out="$out$c" ;;
      *)               out="$out$(printf '%%%02X' "'$c")" ;;
    esac
    i=$((i + 1))
  done
  printf '%s' "$out"
}

# build_issue_body — the human+machine dump a maintainer needs to write a record
build_issue_body() {
  printf 'Reported by imac-linux-check %s. Please review before submitting.\n\n' "$VERSION"
  printf 'Detected hardware:\n\n'
  printf -- '- Model identifier: %s\n' "${HW_MODEL:-unknown}"
  printf -- '- macOS: %s %s\n' "${MACOS_NAME:-unknown}" "${MACOS_VER:-}"
  printf -- '- T2 chip: %s\n' "$T2"
  printf -- '- Detected PCI ids: %s\n\n' "$(printf '%s' "$DETECTED_PCI" | tr '\n' ' ' | sed 's/ *$//')"
  printf 'If you are running Linux on this machine, please add what works and what\n'
  printf 'does not (with kernel version and distro).\n\n'
  printf 'Collector output:\n\n'
  printf '```json\n'
  render_json
  printf '```\n'
}

# report_url — pre-filled /issues/new URL, or empty if too long to encode
report_url() {
  local title body url
  title="$(urlencode "Add model: ${HW_MODEL:-unknown iMac}")"
  body="$(urlencode "$(build_issue_body)")"
  url="https://github.com/$CDN_OWNER_REPO/issues/new?labels=new-model&title=$title&body=$body"
  [ "${#url}" -le "$ISSUE_MAX_URL" ] || return 1
  printf '%s' "$url"
}

if [ "$JSON_ENGINE" = "none" ]; then
  err "no JSON engine (plutil or jq) found; hardware detail will be limited."
fi

case "$OUTPUT" in
  json)     render_json ;;
  markdown) render_markdown ;;
  *)        render_human ;;
esac
